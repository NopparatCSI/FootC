<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Foot C Shop</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CustomerNavbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp1.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="shop-header">
        <div class="promo-bar">
            <div class="promo-inner">
                <span class="promo-text">PROMOTION TEXT RUN</span>
                <div class="promo-links">
                    <a href="/Account/Login">SIGN IN</a>
                    <span class="promo-sep">|</span>
                    <a href="/Account/Register">SIGN UP</a>
                </div>
            </div>
        </div>
        <div class="nav-bar">
            <div class="nav-inner">
                <a class="brand" href="/">LOGO</a>
                <nav class="nav-links">
                    <a href="#">New Arrivals</a>
                    <a href="#">Running Shoes</a>
                    <a href="#">Training Shoes</a>
                    <a href="#">Running Shoes</a>
                    <a href="#">MEN</a>
                    <a href="#">WOMEN</a>
                </nav>
                <div class="nav-actions">
                    <form class="nav-search" role="search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search" placeholder="Search" aria-label="Search" />
                    </form>
                    <button class="icon-btn" aria-label="Favorites">
                        <i class="bi bi-heart" aria-hidden="true"></i>
                    </button>
                    <button class="icon-btn" aria-label="Cart">
                        <i class="bi bi-bag" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main role="main" class="shop-main">
        @RenderBody()
    </main>

    <footer class="shop-footer">
        <div class="footer-top">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4>BRAND</h4>
                    <a href="#">LOGO</a>
                    <a href="#">FB</a>
                    <a href="#">IG</a>
                    <a href="#">TIKTOK</a>
                </div>
                <div class="footer-col">
                    <h4>PRODUCTS</h4>
                    <a href="#">Running Shoes</a>
                    <a href="#">Training Shoes</a>
                    <a href="#">New Arrivals</a>
                    <a href="#">Sales</a>
                </div>
                <div class="footer-col">
                    <h4>SERVICE</h4>
                    <a href="#">Contact Us</a>
                    <a href="#">Shipping Information</a>
                    <a href="#">Size Guide</a>
                    <a href="#">Payment</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="footer-bottom-line">
                <span>© 2026 Foot C Shop</span>
                <span class="footer-divider">|</span>
                <a href="#">Privacy Policy</a>
                <span class="footer-divider">|</span>
                <a href="#">Terms &amp; Conditions</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>