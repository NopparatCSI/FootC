@using WebApp1.ViewModels
@model ProductListViewModel
@{
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/ProductListStyle.css" asp-append-version="true" />

<div class="products-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">Products</h2>
            <p class="page-subtitle">Manage your product catalog</p>
        </div>
    </div>

    <div class="filter-bar">
        <input type="text" id="filterSearch" placeholder="Search by name or SKU" />
        <select id="filterStatus">
            <option value="">All Status</option>
            <option value="Active">Active</option>
            <option value="Draft">Draft</option>
            <option value="Inactive">Inactive</option>
        </select>
        <select id="filterCategory">
            <option value="">All Categories</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat.Text">@cat.Text</option>
            }
        </select>
        <select id="filterGender">
            <option value="">All Genders</option>
            <option value="Men">Men</option>
            <option value="Women">Women</option>
            <option value="Unisex">Unisex</option>
        </select>
    </div>

    <div class="table-card">
        <div class="table-header">All Products (@Model.Products.Count)</div>
        <div class="table-wrapper">
            <table class="product-table" id="productsTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>SKU</th>
                        <th>Brand</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Price</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr data-id="@p.ProductId"
                            data-name="@p.ProductName"
                            data-sku="@p.Sku"
                            data-category="@p.CategoryName"
                            data-status="@p.Status"
                            data-gender="@p.Gender">
                            <td>@p.ProductName</td>
                            <td>@p.Sku</td>
                            <td>@p.BrandName</td>
                            <td>@p.CategoryName</td>
                            <td>
                                <span class="status-pill @(p.Status == "Active" ? "active" : p.Status == "Inactive" ? "inactive" : "")">
                                    @p.Status
                                </span>
                            </td>
                            <td>@p.RegularPrice.ToString("N0")</td>
                            <td>@p.UpdatedAt</td>
                            <td>
                                <div class="table-actions">
                                    <a href="/Products/ProductsEdit?id=@p.ProductId">Edit</a>
                                    <a href="/Products/ProductsView?id=@p.ProductId">View</a>
                                    <a href="/" target="_blank" rel="noopener">Open Storefront</a>
                                    <a href="#" class="action-danger" data-delete-id="@p.ProductId">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="empty-state" id="productsEmpty" style="display:@(Model.Products.Count == 0 ? "block" : "none");">
            No products match your filters.
        </div>
    </div>
</div>

<script>
    (function () {
        const searchInput = document.getElementById('filterSearch');
        const statusSelect = document.getElementById('filterStatus');
        const categorySelect = document.getElementById('filterCategory');
        const genderSelect = document.getElementById('filterGender');
        const table = document.getElementById('productsTable');
        const emptyState = document.getElementById('productsEmpty');
        const rows = table ? Array.from(table.querySelectorAll('tbody tr')) : [];

        function matchesRow(row, search, status, category, gender) {
            const name = (row.dataset.name || '').toLowerCase();
            const sku = (row.dataset.sku || '').toLowerCase();
            const rowStatus = row.dataset.status || '';
            const rowCategory = row.dataset.category || '';
            const rowGender = row.dataset.gender || '';

            const matchesSearch = !search || name.includes(search) || sku.includes(search);
            const matchesStatus = !status || rowStatus === status;
            const matchesCategory = !category || rowCategory === category;
            const matchesGender = !gender || rowGender === gender;

            return matchesSearch && matchesStatus && matchesCategory && matchesGender;
        }

        function applyFilters() {
            const search = (searchInput?.value || '').trim().toLowerCase();
            const status = statusSelect?.value || '';
            const category = categorySelect?.value || '';
            const gender = genderSelect?.value || '';

            let visibleCount = 0;
            rows.forEach((row) => {
                const show = matchesRow(row, search, status, category, gender);
                row.style.display = show ? '' : 'none';
                if (show) {
                    visibleCount += 1;
                }
            });

            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
            }
        }

        [searchInput, statusSelect, categorySelect, genderSelect].forEach((el) => {
            if (el) {
                el.addEventListener('input', applyFilters);
                el.addEventListener('change', applyFilters);
            }
        });

        applyFilters();

        // ── Delete product ──
        document.querySelectorAll('[data-delete-id]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                var productId = parseInt(this.dataset.deleteId);
                if (!confirm('Are you sure you want to delete this product?')) return;

                // ส่ง id ผ่าน form data แบบธรรมดา (ไม่ใช้ JSON)
                var formData = new FormData();
                formData.append('id', productId);

                fetch('/Products/DeleteProduct', {
                    method: 'POST',
                    body: formData
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        var row = document.querySelector('tr[data-id="' + productId + '"]');
                        if (row) row.remove();
                    } else {
                        alert(data.message || 'Delete failed.');
                    }
                })
                .catch(function () { alert('Network error.'); });
            });
        });
    })();
</script>