@{
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/ProductBrandStyle.css" asp-append-version="true" />

<div class="brands-page">

    <!-- ===== Page Header ===== -->
    <div class="page-header">
        <div>
            <h2 class="page-title">Brands</h2>
            <p class="page-subtitle">Manage your product brands</p>
        </div>
        <div class="actions">
            <button class="btn-add" data-bs-toggle="modal" data-bs-target="#addBrandModal">
                <i class="bi bi-plus-lg"></i> Add Brand
            </button>
        </div>
    </div>

    <!-- ===== Stats Cards ===== -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-bookmark-fill"></i></div>
            <div class="stat-info">
                <span class="stat-value" id="statTotal">6</span>
                <span class="stat-label">Total Brands</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-active"><i class="bi bi-check-circle-fill"></i></div>
            <div class="stat-info">
                <span class="stat-value" id="statActive">4</span>
                <span class="stat-label">Active</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-inactive"><i class="bi bi-pause-circle-fill"></i></div>
            <div class="stat-info">
                <span class="stat-value" id="statInactive">2</span>
                <span class="stat-label">Inactive</span>
            </div>
        </div>
    </div>

    <!-- ===== Filter Bar ===== -->
    <div class="filter-bar">
        <div class="search-box">
            <i class="bi bi-search search-icon"></i>
            <input type="text" id="filterSearch" placeholder="Search brands…" />
        </div>
        <select id="filterStatus">
            <option value="">All Status</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>
    </div>

    <!-- ===== Table Card ===== -->
    <div class="table-card">
        <div class="table-header">
            <span>All Brands</span>
            <span class="record-count" id="recordCount">6 brands</span>
        </div>
        <div class="table-wrapper">
            <table class="brand-table" id="brandsTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Brand Name</th>
                        <th>Description</th>
                        <th>Product Count</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-name="Nike" data-status="Active" data-desc="Global leader in athletic footwear and apparel">
                        <td>1</td>
                        <td>
                            <div class="brand-name">
                                <i class="bi bi-bookmark-fill brand-icon"></i>
                                Nike
                            </div>
                        </td>
                        <td><span class="brand-desc">Global leader in athletic footwear and apparel</span></td>
                        <td>24</td>
                        <td><span class="status-pill active">Active</span></td>
                        <td>2026-01-05</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-action" title="Edit"><i class="bi bi-pencil"></i></button>
                                <button class="btn-action btn-danger" title="Delete"><i class="bi bi-trash3"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr data-name="Adidas" data-status="Active" data-desc="Iconic sportswear brand known for the three stripes">
                        <td>2</td>
                        <td>
                            <div class="brand-name">
                                <i class="bi bi-bookmark-fill brand-icon"></i>
                                Adidas
                            </div>
                        </td>
                        <td><span class="brand-desc">Iconic sportswear brand known for the three stripes</span></td>
                        <td>18</td>
                        <td><span class="status-pill active">Active</span></td>
                        <td>2026-01-10</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-action" title="Edit"><i class="bi bi-pencil"></i></button>
                                <button class="btn-action btn-danger" title="Delete"><i class="bi bi-trash3"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr data-name="New Balance" data-status="Active" data-desc="Premium comfort and performance running shoes">
                        <td>3</td>
                        <td>
                            <div class="brand-name">
                                <i class="bi bi-bookmark-fill brand-icon"></i>
                                New Balance
                            </div>
                        </td>
                        <td><span class="brand-desc">Premium comfort and performance running shoes</span></td>
                        <td>12</td>
                        <td><span class="status-pill active">Active</span></td>
                        <td>2026-01-15</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-action" title="Edit"><i class="bi bi-pencil"></i></button>
                                <button class="btn-action btn-danger" title="Delete"><i class="bi bi-trash3"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr data-name="Puma" data-status="Inactive" data-desc="Sport lifestyle brand blending performance and style">
                        <td>4</td>
                        <td>
                            <div class="brand-name">
                                <i class="bi bi-bookmark-fill brand-icon"></i>
                                Puma
                            </div>
                        </td>
                        <td><span class="brand-desc">Sport lifestyle brand blending performance and style</span></td>
                        <td>8</td>
                        <td><span class="status-pill inactive">Inactive</span></td>
                        <td>2026-02-01</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-action" title="Edit"><i class="bi bi-pencil"></i></button>
                                <button class="btn-action btn-danger" title="Delete"><i class="bi bi-trash3"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr data-name="Asics" data-status="Active" data-desc="Japanese brand specializing in running technology">
                        <td>5</td>
                        <td>
                            <div class="brand-name">
                                <i class="bi bi-bookmark-fill brand-icon"></i>
                                Asics
                            </div>
                        </td>
                        <td><span class="brand-desc">Japanese brand specializing in running technology</span></td>
                        <td>6</td>
                        <td><span class="status-pill active">Active</span></td>
                        <td>2026-02-10</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-action" title="Edit"><i class="bi bi-pencil"></i></button>
                                <button class="btn-action btn-danger" title="Delete"><i class="bi bi-trash3"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr data-name="Reebok" data-status="Inactive" data-desc="Fitness-focused brand with classic heritage designs">
                        <td>6</td>
                        <td>
                            <div class="brand-name">
                                <i class="bi bi-bookmark-fill brand-icon"></i>
                                Reebok
                            </div>
                        </td>
                        <td><span class="brand-desc">Fitness-focused brand with classic heritage designs</span></td>
                        <td>3</td>
                        <td><span class="status-pill inactive">Inactive</span></td>
                        <td>2026-03-01</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn-action" title="Edit"><i class="bi bi-pencil"></i></button>
                                <button class="btn-action btn-danger" title="Delete"><i class="bi bi-trash3"></i></button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="empty-state" id="brandsEmpty" style="display:none;">No brands match your filters.</div>
    </div>
</div>

<!-- ===== Add Brand Modal ===== -->
<div class="modal fade" id="addBrandModal" tabindex="-1" aria-labelledby="addBrandLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content brand-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="addBrandLabel">Add Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addBrandForm">
                    <!-- Brand Name -->
                    <div class="form-group">
                        <label for="brandName">Brand Name <span class="required">*</span></label>
                        <input type="text" id="brandName" placeholder="e.g. Nike, Adidas" required />
                    </div>

                    <!-- Description -->
                    <div class="form-group">
                        <label for="brandDesc">Description</label>
                        <textarea id="brandDesc" rows="3" placeholder="Brief description of the brand…"></textarea>
                    </div>

                    <!-- Status -->
                    <div class="form-group">
                        <label for="brandStatus">Status</label>
                        <select id="brandStatus">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-save" id="addSaveBtn">Save Brand</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== Edit Brand Modal ===== -->
<div class="modal fade" id="editBrandModal" tabindex="-1" aria-labelledby="editBrandLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content brand-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="editBrandLabel">Edit Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editBrandForm">
                    <input type="hidden" id="editOriginalName" />

                    <!-- Brand Name -->
                    <div class="form-group">
                        <label for="editBrandName">Brand Name <span class="required">*</span></label>
                        <input type="text" id="editBrandName" placeholder="e.g. Nike, Adidas" required />
                    </div>

                    <!-- Description -->
                    <div class="form-group">
                        <label for="editBrandDesc">Description</label>
                        <textarea id="editBrandDesc" rows="3" placeholder="Brief description of the brand…"></textarea>
                    </div>

                    <!-- Status -->
                    <div class="form-group">
                        <label for="editBrandStatus">Status</label>
                        <select id="editBrandStatus">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-save" id="editSaveBtn">Update Brand</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== Delete Confirm Modal ===== -->
<div class="modal fade" id="deleteBrandModal" tabindex="-1" aria-labelledby="deleteBrandLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content brand-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteBrandLabel">Delete Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="delete-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <p>Are you sure you want to delete <strong id="deleteTargetName"></strong>?</p>
                    <small>This action cannot be undone.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-delete-confirm" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== Scripts ===== -->
<script>
    (function () {
        var table      = document.getElementById('brandsTable');
        var tbody      = table ? table.querySelector('tbody') : null;
        var rows       = tbody ? Array.from(tbody.querySelectorAll('tr')) : [];
        var emptyState = document.getElementById('brandsEmpty');
        var countLabel = document.getElementById('recordCount');

        /* ---------- Filter ---------- */
        var searchInput  = document.getElementById('filterSearch');
        var statusSelect = document.getElementById('filterStatus');

        function applyFilters() {
            var search  = searchInput.value.trim().toLowerCase();
            var status  = statusSelect.value;
            var visible = 0;

            rows.forEach(function (row) {
                var rName   = (row.dataset.name   || '').toLowerCase();
                var rStatus = row.dataset.status   || '';

                var matchSearch = !search || rName.includes(search);
                var matchStatus = !status || rStatus === status;

                if (matchSearch && matchStatus) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            countLabel.textContent = visible + ' brand' + (visible === 1 ? '' : 's');
            emptyState.style.display = visible === 0 ? '' : 'none';
            updateStats();
        }

        searchInput.addEventListener('input', applyFilters);
        statusSelect.addEventListener('change', applyFilters);

        /* ---------- Stats ---------- */
        function updateStats() {
            var total    = rows.length;
            var active   = rows.filter(function (r) { return r.dataset.status === 'Active'; }).length;
            var inactive = rows.filter(function (r) { return r.dataset.status === 'Inactive'; }).length;

            document.getElementById('statTotal').textContent    = total;
            document.getElementById('statActive').textContent   = active;
            document.getElementById('statInactive').textContent = inactive;
        }

        /* ---------- Renumber rows ---------- */
        function renumberRows() {
            rows.forEach(function (row, idx) {
                row.querySelector('td:first-child').textContent = idx + 1;
            });
        }

        /* ---------- Attach row events ---------- */
        function attachRowEvents(row) {
            var editBtn   = row.querySelector('.btn-action[title="Edit"]');
            var deleteBtn = row.querySelector('.btn-action[title="Delete"]');

            if (editBtn) {
                editBtn.addEventListener('click', function () {
                    openEditModal(row);
                });
            }
            if (deleteBtn) {
                deleteBtn.addEventListener('click', function () {
                    openDeleteModal(row);
                });
            }
        }

        rows.forEach(attachRowEvents);

        /* ---------- Add Brand ---------- */
        var addModal   = document.getElementById('addBrandModal');
        var addSaveBtn = document.getElementById('addSaveBtn');

        if (addModal) {
            addModal.addEventListener('show.bs.modal', function () {
                document.getElementById('addBrandForm').reset();
            });
        }

        addSaveBtn.addEventListener('click', function () {
            var name   = document.getElementById('brandName').value.trim();
            var desc   = document.getElementById('brandDesc').value.trim();
            var status = document.getElementById('brandStatus').value;

            if (!name) {
                document.getElementById('brandName').focus();
                return;
            }

            // Check duplicate
            var duplicate = rows.some(function (r) {
                return r.dataset.name.toLowerCase() === name.toLowerCase();
            });
            if (duplicate) {
                alert('Brand "' + name + '" already exists.');
                return;
            }

            var today = new Date().toISOString().slice(0, 10);
            var newRow = document.createElement('tr');
            newRow.dataset.name   = name;
            newRow.dataset.status = status;
            newRow.dataset.desc   = desc;
            newRow.innerHTML =
                '<td>' + (rows.length + 1) + '</td>' +
                '<td><div class="brand-name"><i class="bi bi-bookmark-fill brand-icon"></i>' + escHtml(name) + '</div></td>' +
                '<td><span class="brand-desc">' + escHtml(desc) + '</span></td>' +
                '<td>0</td>' +
                '<td><span class="status-pill ' + (status === 'Active' ? 'active' : 'inactive') + '">' + escHtml(status) + '</span></td>' +
                '<td>' + today + '</td>' +
                '<td><div class="table-actions">' +
                    '<button class="btn-action" title="Edit"><i class="bi bi-pencil"></i></button>' +
                    '<button class="btn-action btn-danger" title="Delete"><i class="bi bi-trash3"></i></button>' +
                '</div></td>';

            tbody.appendChild(newRow);
            rows.push(newRow);
            attachRowEvents(newRow);
            renumberRows();
            applyFilters();

            bootstrap.Modal.getInstance(addModal).hide();
        });

        /* ---------- Edit Brand ---------- */
        var editModal    = document.getElementById('editBrandModal');
        var editSaveBtn  = document.getElementById('editSaveBtn');
        var editingRow   = null;

        function openEditModal(row) {
            editingRow = row;
            document.getElementById('editOriginalName').value = row.dataset.name;
            document.getElementById('editBrandName').value    = row.dataset.name;
            document.getElementById('editBrandDesc').value    = row.dataset.desc || '';
            document.getElementById('editBrandStatus').value  = row.dataset.status;

            var bsModal = new bootstrap.Modal(editModal);
            bsModal.show();
        }

        editSaveBtn.addEventListener('click', function () {
            if (!editingRow) return;

            var name   = document.getElementById('editBrandName').value.trim();
            var desc   = document.getElementById('editBrandDesc').value.trim();
            var status = document.getElementById('editBrandStatus').value;

            if (!name) {
                document.getElementById('editBrandName').focus();
                return;
            }

            // Check duplicate (exclude self)
            var duplicate = rows.some(function (r) {
                return r !== editingRow && r.dataset.name.toLowerCase() === name.toLowerCase();
            });
            if (duplicate) {
                alert('Brand "' + name + '" already exists.');
                return;
            }

            editingRow.dataset.name   = name;
            editingRow.dataset.status = status;
            editingRow.dataset.desc   = desc;

            var cells = editingRow.querySelectorAll('td');
            cells[1].innerHTML = '<div class="brand-name"><i class="bi bi-bookmark-fill brand-icon"></i>' + escHtml(name) + '</div>';
            cells[2].innerHTML = '<span class="brand-desc">' + escHtml(desc) + '</span>';
            cells[4].innerHTML = '<span class="status-pill ' + (status === 'Active' ? 'active' : 'inactive') + '">' + escHtml(status) + '</span>';

            applyFilters();
            bootstrap.Modal.getInstance(editModal).hide();
            editingRow = null;
        });

        /* ---------- Delete Brand ---------- */
        var deleteModal      = document.getElementById('deleteBrandModal');
        var confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        var deletingRow      = null;

        function openDeleteModal(row) {
            deletingRow = row;
            document.getElementById('deleteTargetName').textContent = row.dataset.name;

            var bsModal = new bootstrap.Modal(deleteModal);
            bsModal.show();
        }

        confirmDeleteBtn.addEventListener('click', function () {
            if (!deletingRow) return;

            deletingRow.remove();
            rows = rows.filter(function (r) { return r !== deletingRow; });
            renumberRows();
            applyFilters();

            bootstrap.Modal.getInstance(deleteModal).hide();
            deletingRow = null;
        });

        /* ---------- Helper ---------- */
        function escHtml(str) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(str));
            return div.innerHTML;
        }
    })();
</script>
