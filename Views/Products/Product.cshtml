</div>

@section Scripts {
<script>
(function () {
    // ---------- size guide modal ----------
    const modal = document.getElementById('sizeGuideModal');
    const openBtn = document.getElementById('sizeGuideBtn');
    const closeBtn = document.getElementById('sizeGuideClose');
    const sgTabs = Array.from(document.querySelectorAll('.sg-tab'));

    if (modal && openBtn) {
        openBtn.addEventListener('click', function () {
            modal.hidden = false;
            document.body.style.overflow = 'hidden';
            closeBtn?.focus();
        });

        const closeModal = function () {
            modal.hidden = true;
            document.body.style.overflow = '';
            openBtn.focus();
        };

        closeBtn?.addEventListener('click', closeModal);

        modal.addEventListener('click', function (e) {
            if (e.target === modal) {
                closeModal();
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !modal.hidden) {
                closeModal();
            }
        });

        sgTabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                sgTabs.forEach(function (t) { t.classList.remove('active'); });
                tab.classList.add('active');

                const target = tab.dataset.table;
                document.getElementById('sgTableMen').hidden = (target !== 'men');
                document.getElementById('sgTableWomen').hidden = (target !== 'women');
            });
        });
    }

    // ---------- image gallery nav ----------
    const allImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allImages));
    let currentImageIndex = 0;

    function goToImage(index) {
        const thumbs = Array.from(document.querySelectorAll('.cp-thumb'));
        const total = allImages.length;
        currentImageIndex = ((index % total) + total) % total;
        document.getElementById('mainImage').src = allImages[currentImageIndex];
        thumbs.forEach((t, i) => t.classList.toggle('active', i === currentImageIndex));
    }

    document.getElementById('imgPrev')?.addEventListener('click', function () {
        goToImage(currentImageIndex - 1);
    });
    document.getElementById('imgNext')?.addEventListener('click', function () {
        goToImage(currentImageIndex + 1);
    });

    window.setMainImage = function (thumb) {
        const thumbs = Array.from(document.querySelectorAll('.cp-thumb'));
        currentImageIndex = thumbs.indexOf(thumb);
        document.getElementById('mainImage').src = thumb.src;
        thumbs.forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');
    };

    // ---------- favorite ----------
    const favBtn = document.getElementById('favBtn');
    const favIcon = document.getElementById('favIcon');
    const favText = document.getElementById('favText');
    const productId = favBtn ? favBtn.dataset.productId : null;
    const FAV_KEY = 'cp_favorites';
    const CART_KEY = 'cp_cart';
    const isCustomerLoggedIn = @(Model.IsCustomerLoggedIn ? "true" : "false");
    const customerLoginUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(customerLoginUrl));

    function getFavs() {
        try { return JSON.parse(localStorage.getItem(FAV_KEY) || '[]'); } catch { return []; }
    }
    function saveFavs(arr) {
        localStorage.setItem(FAV_KEY, JSON.stringify(arr));
    }
    function applyFavState(isFav) {
        if (!favBtn) return;
        favBtn.classList.toggle('is-fav', isFav);
        favIcon.className = isFav ? 'bi bi-heart-fill' : 'bi bi-heart';
        favText.textContent = isFav ? 'Saved' : 'Favorite';
    }

    if (productId) {
        applyFavState(getFavs().includes(productId));
        favBtn.addEventListener('click', function () {
            if (!isCustomerLoggedIn) {
                window.location.href = customerLoginUrl;
                return;
            }

            let favs = getFavs();
            const isFav = favs.includes(productId);
            if (isFav) {
                favs = favs.filter(id => id !== productId);
            } else {
                favs.push(productId);
            }
            saveFavs(favs);
            applyFavState(!isFav);
        });
    }

    // ---------- color swatch ----------
    window.pickColor = function (btn, name) {
        document.querySelectorAll('.cp-swatch').forEach(s => s.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('selectedColor').textContent = name;
    };

    // ---------- size type tabs ----------
    const euSizes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(euSizes));
    const usSizes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(usSizes));

    window.switchSizeType = function (tab, type) {
        document.querySelectorAll('.cp-size-type-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const grid = document.getElementById('sizeGrid');
        const sizes = type === 'US' ? usSizes : euSizes;
        grid.innerHTML = sizes.map(s =>
            '<button type="button" class="cp-size-btn" onclick="pickSize(this)">' + s + '</button>'
        ).join('');

        const first = grid.querySelector('.cp-size-btn');
        if (first) {
            first.classList.add('active');
        }
    };

    // ---------- size pick ----------
    window.pickSize = function (btn) {
        if (btn.classList.contains('disabled')) return;
        document.querySelectorAll('.cp-size-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    };

    // ---------- quantity ----------
    window.changeQty = function (d) {
        const el = document.getElementById('qtyValue');
        let v = parseInt(el.value) || 1;
        v = Math.max(1, v + d);
        el.value = v;
    };

    // ---------- add to bag ----------
    function getCart() {
        try {
            const parsed = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
            return Array.isArray(parsed) ? parsed : [];
        } catch {
            return [];
        }
    }

    function saveCart(items) {
        localStorage.setItem(CART_KEY, JSON.stringify(items));
    }

    const cartModal = document.getElementById('cartAddedModal');
    const cartContinueBtn = document.getElementById('cartContinueBtn');

    function openCartModal() {
        if (!cartModal) return;
        cartModal.hidden = false;
        document.body.style.overflow = 'hidden';
        cartContinueBtn?.focus();
    }

    function closeCartModal() {
        if (!cartModal) return;
        cartModal.hidden = true;
        document.body.style.overflow = '';
    }

    cartContinueBtn?.addEventListener('click', closeCartModal);
    cartModal?.addEventListener('click', function (e) {
        if (e.target === cartModal) {
            closeCartModal();
        }
    });

    const addToBagBtn = document.getElementById('addToBagBtn');
    addToBagBtn?.addEventListener('click', function () {
        const qty = Math.max(1, parseInt(document.getElementById('qtyValue')?.value || '1', 10) || 1);
        const selectedSize = document.querySelector('.cp-size-btn.active')?.textContent?.trim() || '';
        const selectedSizeType = document.querySelector('.cp-size-type-tab.active')?.textContent?.trim() || 'EU';
        const selectedColor = document.getElementById('selectedColor')?.textContent?.trim() || 'Default';
        const currentPrice = @currentPrice.ToString(System.Globalization.CultureInfo.InvariantCulture);

        const keyBase = '@Model.Id' + '|' + selectedColor + '|' + selectedSize;
        const cart = getCart();
        const existing = cart.find(item => item.key === keyBase);

        if (existing) {
            existing.qty = (Number(existing.qty) || 1) + qty;
        } else {
            cart.push({
                key: keyBase,
                productId: @Model.Id,
                name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name)),
                brandName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Brand)),
                gender: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Gender)),
                imageUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allImages[0])),
                color: selectedColor,
                size: selectedSize,
                sizeType: selectedSizeType,
                qty: qty,
                unitPrice: Number(currentPrice)
            });
        }

        saveCart(cart);
        openCartModal();
    });

    // Default first size as selected for better UX.
    const firstSize = document.querySelector('#sizeGrid .cp-size-btn');
    if (firstSize) {
        firstSize.classList.add('active');
    }
})();
</script>
}
