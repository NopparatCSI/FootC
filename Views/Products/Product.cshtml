                        <tr><td>6.5</td><td>39</td><td>6</td><td>24.5</td></tr>
                        <tr><td>7</td><td>40</td><td>6.5</td><td>25.0</td></tr>
                        <tr><td>7.5</td><td>40.5</td><td>7</td><td>25.5</td></tr>
                        <tr><td>8</td><td>41</td><td>7.5</td><td>26.0</td></tr>
                        <tr><td>8.5</td><td>42</td><td>8</td><td>26.5</td></tr>
                        <tr><td>9</td><td>42.5</td><td>8.5</td><td>27.0</td></tr>
                        <tr><td>9.5</td><td>43</td><td>9</td><td>27.5</td></tr>
                        <tr><td>10</td><td>44</td><td>9.5</td><td>28.0</td></tr>
                        <tr><td>10.5</td><td>44.5</td><td>10</td><td>28.5</td></tr>
                        <tr><td>11</td><td>45</td><td>10.5</td><td>29.0</td></tr>
