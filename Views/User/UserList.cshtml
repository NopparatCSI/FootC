@model IEnumerable<WebApp1.Models.Db.Customer>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User List";
}

<link rel="stylesheet" href="~/css/UserListStyle.css" asp-append-version="true" />

<div class="users-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h2 class="page-title">Users</h2>
            <p class="page-subtitle">Manage registered customers</p>
        </div>
        <div class="header-stats">
            <span class="stat-badge">
                <i class="bi bi-people-fill"></i>
                <span id="totalCount">@(Model?.Count() ?? 0)</span> Total
            </span>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="filterSearch" placeholder="Search by name, email or phone..." />
        </div>
        <select id="filterStatus">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
    </div>

    <!-- Table Card -->
    <div class="table-card">
        <div class="table-header">
            <span>All Users</span>
        </div>

        <div class="table-wrapper">
            <table class="user-table" id="userTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Birth Date</th>
                        <th>Registered</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        @foreach (var user in Model)
                        {
                            <tr data-name="@user.NameCustomer @user.LastnameCustomer"
                                data-email="@user.EmailCustomer"
                                data-phone="@user.Phonenumber">
                                <td>@index</td>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar">
                                            @(user.NameCustomer?.Length > 0 ? user.NameCustomer[0].ToString().ToUpper() : "?")
                                        </div>
                                        <div>
                                            <div class="user-name">@user.NameCustomer @user.LastnameCustomer</div>
                                            <div class="user-id">ID: @user.UserId</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.EmailCustomer</td>
                                <td>@user.Phonenumber</td>
                                <td>@(user.BirthDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td>@(user.Utimestamp?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td><span class="status-pill active">Active</span></td>
                                <td>
                                    <div class="table-actions">
                                        <button class="btn-action" title="View">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <a class="btn-action" title="Edit" asp-action="UserEdit" asp-controller="User" asp-route-id="@user.UserId">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn-action btn-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <!-- Sample / placeholder rows when no data -->
                        <tr data-name="Somchai Jaidee" data-email="somchai@example.com" data-phone="081-234-5678">
                            <td>1</td>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar">S</div>
                                    <div>
                                        <div class="user-name">Somchai Jaidee</div>
                                        <div class="user-id">ID: 1001</div>
                                    </div>
                                </div>
                            </td>
                            <td>somchai&#64;example.com</td>
                            <td>081-234-5678</td>
                            <td>1995-06-15</td>
                            <td>2026-01-10 09:30</td>
                            <td><span class="status-pill active">Active</span></td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn-action" title="View"><i class="bi bi-eye"></i></button>
                                    <button class="btn-action" title="Edit"><i class="bi bi-pencil"></i></button>
                                    <button class="btn-action btn-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                        <tr data-name="Suda Meesuk" data-email="suda@example.com" data-phone="089-876-5432">
                            <td>2</td>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar">S</div>
                                    <div>
                                        <div class="user-name">Suda Meesuk</div>
                                        <div class="user-id">ID: 1002</div>
                                    </div>
                                </div>
                            </td>
                            <td>suda&#64;example.com</td>
                            <td>089-876-5432</td>
                            <td>1998-03-22</td>
                            <td>2026-02-05 14:15</td>
                            <td><span class="status-pill active">Active</span></td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn-action" title="View"><i class="bi bi-eye"></i></button>
                                    <button class="btn-action" title="Edit"><i class="bi bi-pencil"></i></button>
                                    <button class="btn-action btn-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                        <tr data-name="Piyapong Srisai" data-email="piyapong@example.com" data-phone="062-111-2233">
                            <td>3</td>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar">P</div>
                                    <div>
                                        <div class="user-name">Piyapong Srisai</div>
                                        <div class="user-id">ID: 1003</div>
                                    </div>
                                </div>
                            </td>
                            <td>piyapong&#64;example.com</td>
                            <td>062-111-2233</td>
                            <td>2000-11-08</td>
                            <td>2026-03-01 10:00</td>
                            <td><span class="status-pill">Inactive</span></td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn-action" title="View"><i class="bi bi-eye"></i></button>
                                    <button class="btn-action" title="Edit"><i class="bi bi-pencil"></i></button>
                                    <button class="btn-action btn-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="empty-state" id="usersEmpty" style="display:none;">
            <i class="bi bi-person-x" style="font-size:28px;color:#999;"></i>
            <p>No users match your search.</p>
        </div>
    </div>
</div>

<!-- Client-side filter script -->
<script>
    (function () {
        const searchInput = document.getElementById('filterSearch');
        const statusSelect = document.getElementById('filterStatus');
        const table = document.getElementById('userTable');
        const emptyState = document.getElementById('usersEmpty');
        const rows = table ? Array.from(table.querySelectorAll('tbody tr')) : [];

        function applyFilters() {
            const query = (searchInput.value || '').toLowerCase();
            const status = (statusSelect.value || '').toLowerCase();
            let visible = 0;

            rows.forEach(function (row) {
                const name = (row.dataset.name || '').toLowerCase();
                const email = (row.dataset.email || '').toLowerCase();
                const phone = (row.dataset.phone || '').toLowerCase();
                const pill = row.querySelector('.status-pill');
                const rowStatus = pill ? pill.textContent.trim().toLowerCase() : '';

                const matchSearch = !query || name.includes(query) || email.includes(query) || phone.includes(query);
                const matchStatus = !status || rowStatus === status;

                if (matchSearch && matchStatus) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (emptyState) {
                emptyState.style.display = visible === 0 ? 'block' : 'none';
            }
        }

        if (searchInput) searchInput.addEventListener('input', applyFilters);
        if (statusSelect) statusSelect.addEventListener('change', applyFilters);
    })();
</script>
