@model WebApp1.ViewModels.BannerManagementViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Banner Management";
}

<style>
    .bm-page { padding: 28px 24px; width: 100%; }

    .bm-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 28px;
    }

    .bm-header h2 {
        font-size: 20px;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .bm-header p {
        font-size: 13px;
        color: #6b7280;
        margin: 4px 0 0;
    }

    .bm-alert {
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 13.5px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .bm-alert.success { background: #ecfdf5; color: #065f46; border: 1px solid #6ee7b7; }
    .bm-alert.error   { background: #fef2f2; color: #991b1b; border: 1px solid #fca5a5; }

    .bm-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 20px;
    }

    .bm-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .bm-card-head {
        padding: 14px 16px;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .bm-slot-label {
        font-size: 14px;
        font-weight: 600;
        color: #111827;
        margin: 0;
    }

    .bm-chip {
        font-size: 11px;
        border-radius: 999px;
        padding: 4px 9px;
        color: #1f2937;
        border: 1px solid #d1d5db;
        background: #f9fafb;
    }

    .bm-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .bm-preview-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .bm-preview {
        width: 100%;
        aspect-ratio: 16 / 8;
        background: #f3f4f6;
        border-radius: 10px;
        overflow: hidden;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bm-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .bm-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        color: #9ca3af;
        font-size: 12px;
        min-height: 120px;
        justify-content: center;
        border: 1px dashed #d1d5db;
        border-radius: 10px;
    }

    .bm-image-meta {
        position: absolute;
        left: 8px;
        bottom: 8px;
        font-size: 11px;
        color: #fff;
        background: rgba(0, 0, 0, 0.55);
        border-radius: 999px;
        padding: 2px 8px;
    }

    .bm-delete-form {
        position: absolute;
        right: 8px;
        top: 8px;
        margin: 0;
    }

    .btn-bm-delete {
        border: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        cursor: pointer;
    }

    .bm-upload-form {
        display: flex;
        flex-direction: column;
        gap: 10px;
        border-top: 1px solid #f3f4f6;
        padding-top: 12px;
    }

    .bm-file-input input[type="file"] {
        display: block;
        width: 100%;
        padding: 6px 0;
        font-size: 13px;
        color: #374151;
    }

    .btn-bm-upload {
        padding: 8px 16px;
        background: #111827;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: background 0.15s;
    }

    .btn-bm-upload:hover { background: #1f2937; }

    .bm-section-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #9ca3af;
        margin: 0 0 16px;
    }
</style>

<div class="bm-page">

    <div class="bm-header">
        <div>
            <h2><i class="bi bi-images me-2"></i>Banner Management</h2>
            <p>Banner Slide รองรับหลายรูปและแสดงแบบอัตโนมัติในหน้าแรก</p>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> กลับ Dashboard
        </a>
    </div>

    @if (TempData["BannerMessage"] != null)
    {
        <div class="bm-alert success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["BannerMessage"]
        </div>
    }

    @if (TempData["BannerError"] != null)
    {
        <div class="bm-alert error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["BannerError"]
        </div>
    }

    <div class="bm-section-label">Banner Slides (อัปโหลดได้หลายรูป)</div>
    <div class="bm-grid" style="margin-bottom: 30px;">
        @foreach (var slot in Model.SlideSlots)
        {
            <div class="bm-card">
                <div class="bm-card-head">
                    <p class="bm-slot-label">@slot.Label</p>
                    <span class="bm-chip">@slot.ImagePaths.Count รูป</span>
                </div>

                <div class="bm-body">
                    @if (slot.ImagePaths.Count == 0)
                    {
                        <div class="bm-empty">
                            <i class="bi bi-image"></i>
                            <span>ยังไม่มีรูปภาพ</span>
                        </div>
                    }
                    else
                    {
                        <div class="bm-preview-grid">
                            @for (var i = 0; i < slot.ImagePaths.Count; i++)
                            {
                                var imagePath = slot.ImagePaths[i];
                                <div class="bm-preview">
                                    <img src="@imagePath" alt="@slot.Label @(@i + 1)" />
                                    <span class="bm-image-meta">รูปที่ @(@i + 1)</span>
                                    <form asp-action="DeleteBannerImage" method="post" class="bm-delete-form"
                                          onsubmit="return confirm('ลบรูปนี้ออกจากสไลด์?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="slotKey" value="@slot.Key" />
                                        <input type="hidden" name="imagePath" value="@imagePath" />
                                        <button type="submit" class="btn-bm-delete" title="ลบรูป">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }

                    <form asp-action="UploadBannerImage" method="post" enctype="multipart/form-data" class="bm-upload-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="slotKey" value="@slot.Key" />
                        <div class="bm-file-input">
                            <input type="file" name="images" multiple accept="image/jpeg,image/png,image/webp,image/gif" required />
                        </div>
                        <button type="submit" class="btn-bm-upload">
                            <i class="bi bi-cloud-arrow-up"></i> อัปโหลดหลายรูป
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="bm-section-label">Category Tiles (อัปโหลดทีละรูป)</div>
    <div class="bm-grid">
        @foreach (var slot in Model.CategorySlots)
        {
            <div class="bm-card">
                <div class="bm-card-head">
                    <p class="bm-slot-label">@slot.Label</p>
                    <span class="bm-chip">1 รูป</span>
                </div>

                <div class="bm-body">
                    @if (string.IsNullOrWhiteSpace(slot.ImagePath))
                    {
                        <div class="bm-empty">
                            <i class="bi bi-image"></i>
                            <span>ยังไม่มีรูปภาพ</span>
                        </div>
                    }
                    else
                    {
                        <div class="bm-preview">
                            <img src="@slot.ImagePath" alt="@slot.Label" />
                            <form asp-action="DeleteBannerImage" method="post" class="bm-delete-form"
                                  onsubmit="return confirm('ลบรูปภาพนี้?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="slotKey" value="@slot.Key" />
                                <button type="submit" class="btn-bm-delete" title="ลบรูป">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    }

                    <form asp-action="UploadBannerImage" method="post" enctype="multipart/form-data" class="bm-upload-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="slotKey" value="@slot.Key" />
                        <div class="bm-file-input">
                            <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" required />
                        </div>
                        <button type="submit" class="btn-bm-upload">
                            <i class="bi bi-cloud-arrow-up"></i> อัปโหลดรูป
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

</div>
