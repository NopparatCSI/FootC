@using System.Security.Claims
@using WebApp1.Security
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    var adminName = User.Identity?.Name ?? "Admin";
    var adminRole = User.FindFirstValue(ClaimTypes.Role) ?? AdminRoles.Support;
    var canManageCatalog  = User.IsInRole(AdminRoles.SuperAdmin) || User.IsInRole(AdminRoles.CatalogManager);
    var canManageOrders   = User.IsInRole(AdminRoles.SuperAdmin) || User.IsInRole(AdminRoles.OrderManager);
    var canManageUsers    = User.IsInRole(AdminRoles.SuperAdmin) || User.IsInRole(AdminRoles.Support);
    var canManageAdmins   = User.IsInRole(AdminRoles.SuperAdmin);
}

<style>
    .dash-page { padding: 28px 24px; width: 100%; }

    .dash-welcome {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 32px;
    }

    .dash-welcome-text h2 {
        font-size: 22px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 4px;
    }

    .dash-welcome-text p {
        font-size: 13px;
        color: #6b7280;
        margin: 0;
    }

    .dash-role-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        border: 1.5px solid #111827;
        background: #111827;
        color: #fff;
    }

    /* ---- Access cards grid ---- */
    .dash-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
    }

    .dash-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .dash-card:hover {
        border-color: #111827;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        color: inherit;
        text-decoration: none;
    }

    .dash-card.locked {
        opacity: 0.45;
        pointer-events: none;
    }

    .dash-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: #111827;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .dash-card-icon.gray {
        background: #f3f4f6;
        color: #d1d5db;
    }

    .dash-card-title {
        font-size: 15px;
        font-weight: 600;
        color: #111827;
    }

    .dash-card-desc {
        font-size: 12.5px;
        color: #6b7280;
        line-height: 1.5;
    }

    .dash-card-badge {
        font-size: 11px;
        color: #9ca3af;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .dash-section-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #9ca3af;
        margin: 28px 0 12px;
    }
</style>

<div class="dash-page">

    <!-- Welcome -->
    <div class="dash-welcome">
        <div class="dash-welcome-text">
            <h2>สวัสดี, @adminName</h2>
            <p>คุณเข้าสู่ระบบในฐานะ Admin — ทำรายการตามสิทธิ์ที่ได้รับด้านล่าง</p>
        </div>
        <span class="dash-role-chip">
            <i class="bi bi-person-gear"></i> @adminRole
        </span>
    </div>

    <!-- Access cards -->
    <div class="dash-section-label">เมนูที่เข้าถึงได้</div>

    <div class="dash-grid">

        <a class="dash-card" asp-controller="Products" asp-action="ProductsList">
            <div class="dash-card-icon @(canManageCatalog ? "" : "gray")">
                <i class="bi bi-box-seam"></i>
            </div>
            <div>
                <div class="dash-card-title">Products</div>
                <div class="dash-card-desc">จัดการสินค้า หมวดหมู่ แบรนด์ และสต็อก</div>
            </div>
            <div class="dash-card-badge">
                @if (canManageCatalog)
                {
                    <i class="bi bi-check-circle text-success"></i> <span>มีสิทธิ์เข้าถึง</span>
                }
                else
                {
                    <i class="bi bi-lock"></i> <span>ต้องการ CatalogManager ขึ้นไป</span>
                }
            </div>
        </a>

        <a class="dash-card @(canManageOrders ? "" : "locked")" asp-controller="Order" asp-action="OrdersList">
            <div class="dash-card-icon @(canManageOrders ? "" : "gray")">
                <i class="bi bi-receipt"></i>
            </div>
            <div>
                <div class="dash-card-title">Orders</div>
                <div class="dash-card-desc">ดูและจัดการคำสั่งซื้อ การจัดส่ง และการชำระเงิน</div>
            </div>
            <div class="dash-card-badge">
                @if (canManageOrders)
                {
                    <i class="bi bi-check-circle text-success"></i> <span>มีสิทธิ์เข้าถึง</span>
                }
                else
                {
                    <i class="bi bi-lock"></i> <span>ต้องการ OrderManager ขึ้นไป</span>
                }
            </div>
        </a>

        <a class="dash-card @(canManageUsers ? "" : "locked")" asp-controller="User" asp-action="Index">
            <div class="dash-card-icon @(canManageUsers ? "" : "gray")">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="dash-card-title">Users</div>
                <div class="dash-card-desc">ดูข้อมูลและแก้ไขบัญชีลูกค้า</div>
            </div>
            <div class="dash-card-badge">
                @if (canManageUsers)
                {
                    <i class="bi bi-check-circle text-success"></i> <span>มีสิทธิ์เข้าถึง</span>
                }
                else
                {
                    <i class="bi bi-lock"></i> <span>ต้องการ Support ขึ้นไป</span>
                }
            </div>
        </a>

        <a class="dash-card @(canManageAdmins ? "" : "locked")" asp-controller="Admin" asp-action="AdminList">
            <div class="dash-card-icon @(canManageAdmins ? "" : "gray")">
                <i class="bi bi-person-gear"></i>
            </div>
            <div>
                <div class="dash-card-title">Admin Management</div>
                <div class="dash-card-desc">เพิ่ม ลบ และกำหนด Role ให้ผู้ดูแลระบบ</div>
            </div>
            <div class="dash-card-badge">
                @if (canManageAdmins)
                {
                    <i class="bi bi-check-circle text-success"></i> <span>มีสิทธิ์เข้าถึง (SuperAdmin)</span>
                }
                else
                {
                    <i class="bi bi-lock"></i> <span>ต้องการ SuperAdmin</span>
                }
            </div>
        </a>

    </div>

</div>