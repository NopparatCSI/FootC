        <input asp-for="UserId" type="hidden" />

        <label asp-for="UserId"></label>
        <input asp-for="UserId" class="form-control" readonly>

        <label asp-for="NameCustomer" class="mt-2"></label>
        <input asp-for="NameCustomer" class="form-control">

        <label asp-for="LastnameCustomer" class="mt-2"></label>
