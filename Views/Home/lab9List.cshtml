@model IEnumerable<WebApp1.Models.Db.Customer>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>User ID</th>
            <th>Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Birth Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserId</td>
                <td>@item.NameCustomer</td>
                <td>@item.LastnameCustomer</td>
                <td>@item.EmailCustomer</td>
                <td>@item.Phonenumber</td>
                <td>@item.BirthDate</td>
                <td>
                    <a asp-route-UserId="@item.UserId" asp-action="Lab10" asp-controller="Home"
                       class="btn btn-primary">Edit</a>
                </td>
                <td>
                    <a asp-route-UserId="@item.UserId" asp-action="Lab10D" asp-controller="Home"
                       class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>