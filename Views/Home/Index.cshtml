@{
    Layout = "_CustomerNavbar";
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/CustomerIndex.css" asp-append-version="true" />
}

<div class="customer-index-page">
    <section class="placeholder-banner banner-lg">
        <button class="banner-nav"><i class="bi bi-chevron-left"></i></button>
        <h1>Banner Slide</h1>
        <button class="banner-nav"><i class="bi bi-chevron-right"></i></button>
    </section>

    <section class="product-zone">
        <div class="product-head">
            <h2>POPPULAR PRODUCT</h2>
            <div class="head-actions">
                <button><i class="bi bi-chevron-left"></i></button>
                <button><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
        <div class="row row-cols-2 row-cols-md-4 g-4">
            <div class="col"><div class="product-placeholder"></div></div>
            <div class="col"><div class="product-placeholder"></div></div>
            <div class="col"><div class="product-placeholder"></div></div>
            <div class="col"><div class="product-placeholder"></div></div>
        </div>

        <div class="product-head mt-4">
            <h2>SALES PRODUCT</h2>
            <div class="head-actions">
                <button><i class="bi bi-chevron-left"></i></button>
                <button><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
        <div class="row row-cols-2 row-cols-md-4 g-4">
            <div class="col"><div class="product-placeholder"></div></div>
            <div class="col"><div class="product-placeholder"></div></div>
            <div class="col"><div class="product-placeholder"></div></div>
            <div class="col"><div class="product-placeholder"></div></div>
        </div>
    </section>

    <section class="placeholder-banner banner-md">
        <button class="banner-nav"><i class="bi bi-chevron-left"></i></button>
        <h2>Banner Slide</h2>
        <button class="banner-nav"><i class="bi bi-chevron-right"></i></button>
    </section>

    <section class="category-section">
        <div class="row g-0">
            <div class="col-12 col-md-6">
                <div class="category-tile">
                    <h3>New Arrivals</h3>
                    <button>Buy</button>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="category-tile">
                    <h3>Sales</h3>
                    <button>Buy</button>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="category-tile">
                    <h3>Running Shose</h3>
                    <button>Buy</button>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="category-tile">
                    <h3>Training Shose</h3>
                    <button>Buy</button>
                </div>
            </div>
        </div>
    </section>
</div>