# .gitignore for ASP.NET Core / .NET projects
# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Others
wwwroot/lib/
wwwroot/node_modules/

# Rider
.idea/

# NuGet
*.nupkg
packages/

# Publish outputs
publish/

# Database
*.mdf
*.ldf

# Others
*.db
*.sqlite
