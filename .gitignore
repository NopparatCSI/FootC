# .gitignore for ASP.NET Core / .NET projects
# Build results
bin/
obj/
temp-build-output/
TestResults/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/
.vs/

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Others
wwwroot/lib/
wwwroot/node_modules/

# Rider
.idea/

# NuGet
*.nupkg
packages/

# Publish outputs
publish/

# Generated docs
FolderMarkdown/

# Database
*.mdf
*.ldf

# Others
*.db
*.sqlite

# App secrets / environment-specific config
appsettings.json
appsettings.Development.json
